{
  "cli": {
    "version": ">=22.2.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EAS_NO_VCS": "1"
      },
      "ios": {
        "scheme": "Near",
        "buildConfiguration": "Release",
        "credentialsSource": "remote",
        "image": "latest",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804509012"
      }
    }
  }
}
